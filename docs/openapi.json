  "components": {
    "schemas": {
      "Assignment": {
        "properties": {
          "face_ids": {
            "items": {
              "type": "integer"
            },
            "type": "array",
            "maxItems": 200,
            "minItems": 1,
            "title": "Face Ids"
          },
          "confirmed": {
            "type": "boolean",
            "const": true,
            "title": "Confirmed"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "face_ids",
          "confirmed"
        ],
        "title": "Assignment"
      },
      "FaceReview": {
        "properties": {
          "face_ids": {
            "items": {
              "type": "integer"
            },
            "type": "array",
            "maxItems": 200,
            "minItems": 1,
            "title": "Face Ids"
          },
          "group_id": {
            "anyOf": [
              {
                "type": "integer",
                "exclusiveMinimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Group Id"
          },
          "ignored": {
            "type": "boolean",
            "title": "Ignored",
            "default": false
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "face_ids"
        ],
        "title": "FaceReview"
      },
      "GroupPatch": {
        "properties": {
          "name": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 100,
                "minLength": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Name"
          },
          "performer_id": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 128,
                "pattern": "^[0-9]+$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Performer Id"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "GroupPatch"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "JobRequest": {
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "scan",
              "image",
              "forget"
            ],
            "title": "Action"
          },
          "image_id": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 128,
                "pattern": "^[0-9]+$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Image Id"
          },
          "force": {
            "type": "boolean",
            "title": "Force",
            "default": false
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "action"
        ],
        "title": "JobRequest"
      },
      "NewGroup": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Name"
          },
          "performer_id": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 128,
                "pattern": "^[0-9]+$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Performer Id"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "name"
        ],
        "title": "NewGroup"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    },
    "securitySchemes": {
      "APIKeyHeader": {
        "type": "apiKey",
        "in": "header",
        "name": "X-API-Token"
      }
    }
  }
