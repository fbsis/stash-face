# Stash Face Recognition service configuration.
# Never commit real API keys or service tokens.
STASH_URL=https://stash.example.com
STASH_API_KEY=
FACE_TOKEN=
FACE_DATA_DIR=/var/lib/stash-face
FACE_MODELS_DIR=/var/lib/stash-face/models
FACE_BIND=127.0.0.1
FACE_PORT=8765
FACE_PROVIDER=insightface
# AUTO/GPU uses OpenVINO GPU when the Intel runtime exposes it; otherwise CPU fallback.
FACE_DEVICE=AUTO
# Set to the number of allocated CPUs. Jobs share one model and are claimed concurrently.
FACE_WORKERS=4
FACE_MODEL_NAME=buffalo_l
FACE_CLUSTER_EPS=0.45
FACE_MIN_FACES=2
FACE_PERFORMER_THRESHOLD=0.42
FACE_AUTO_TAG_STASH=true
FACE_MIN_SCORE=0.7
FACE_MIN_SIZE=40
FACE_TIMEOUT=15
FACE_MAX_ATTEMPTS=3
FACE_RETRY_SECONDS=5
FACE_MAX_IMAGE_BYTES=20000000
FACE_MAX_IMAGE_PIXELS=40000000
FACE_VIDEO_ROOTS=/mnt
